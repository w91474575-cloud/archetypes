{UTF-8}
effect of resource crowding on depreciation=A FUNCTION OF(effect of resource crowding on depreciation\
		,carrying capacity,resource) ~~|
effect of resource crowding on depreciation = WITH LOOKUP (resource/carrying capacity\
		,
		([(0,0)-(8,8)],))
	~	1
	~		|

resource= INTEG (regeneration-extraction-resource depreciation,
		initial resource)
	~	resource
	~		|

resource depreciation  = A FUNCTION OF( effect of resource crowding on depreciation,resource lifespan\
		)
	~	
	~		|

carrying capacity=2000
	~	resource
	~		|

resource lifespan  = A FUNCTION OF( )
	~	
	~		|

profit per year=extraction*price-capital charge rate per year*capital
	~	capital/Year
	~		|

capital charge rate per year=0.1
	~	1/Year
	~		|

capital= INTEG (investment-depreciation,
		initial capital)
	~	capital
	~		|

capital lifetime=20
	~	years
	~		|

depreciation=capital/capital lifetime
	~	capital/Year
	~		|

extraction=capital*resource yield per capital per year
	~	resource/Year
	~		|

growth goal capital per year=capital*growth rate per year
	~	capital/Year
	~		|

growth rate per year=0.1
	~	1/Year
	~		|

initial capital=6
	~	capital
	~		|

initial resource=1000
	~	resource
	~		|

investment=min(growth goal capital per year,profit per year)
	~	capital/Year
	~		|

price = WITH LOOKUP (resource yield per capital per year,
		([(0,0)-(1,10)],(0,10), (0.207831,6.16715), (0.403614,3.54467), (0.60241,2.42075), \
		(0.804217,1.61383), (1,1.26801)))
	~	capital/resource
	~		|

regeneration=regeneration rate per year*resource
	~	resource/Year
	~		|

regeneration rate per year=0.01
	~	1/Year
	~		|

resource yield per capital per year = WITH LOOKUP (resource,
		([(0,0)-(16000,1)],(0,0), (250,0.5), (500,0.75), (750,0.825), (1000,0.8625), (2000,\
		0.9), (4000,0.925), (8000,0.94782), (16000,0.96)))
	~	resource/capital/Year
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 100
	~	Year
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Year
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP
	~	Year [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 1
	~	Year [0,?]
	~	The time step for the simulation.
	|

