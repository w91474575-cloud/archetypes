{UTF-8}
growth rate fraction=0.1
	~	1/Year
	~		|

capital charge rate=0.1
	~	1/Year
	~		|

capital efficiency = WITH LOOKUP (resource,
		([(0,0)-(4000,1)],(0,0), (250,0.5), (500,0.84), (750,0.93), (1000,0.97), (2000,0.99\
		), (4000,1)))
	~	resource/(capital*Year)
	~		|

growth goal=capital*growth rate fraction
	~	capital/Year
	~		|

price = WITH LOOKUP (1/(capital efficiency+1),
		([(0,0)-(1,10)],(0,10), (0.25,5), (0.5,2.2), (0.75,1.45), (1,1.2)))
	~	capital/resource
	~		|

profit=price*extraction-capital*capital charge rate
	~	capital/Year
	~		|

capital= INTEG (investment-depreciation,
		initial capital)
	~	capital
	~		|

capital lifespan=20
	~	Year
	~		|

depreciation=capital/capital lifespan
	~	capital/Year
	~		|

extraction=capital*capital efficiency
	~	resource/Year
	~		|

initial capital=5
	~	capital
	~		|

initial resource=1000
	~	resource
	~		|

investment=min(profit,growth goal)
	~	capital/Year
	~		|

resource= INTEG (-extraction,
		initial resource)
	~	resource
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 120
	~	Year
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Year
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP
	~	Year [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 1
	~	Year [0,?]
	~	The time step for the simulation.
	|

\\\---/// Sketch information - do not modify anything except names
