{UTF-8}
sales=MIN (customer demand cars per day*effect of inventory on sales, inventory/TIME STEP\
		)
	~	cars/Day
	~		|

effect of inventory on sales = WITH LOOKUP (MIN(inventory/customer demand cars per day\
		, 10),
		([(0,0)-(10,1)],(0,0), (2,0.8), (5,1), (10,1)))
	~	1
	~		|

customer demand cars per day=delay fixed (ending customer demand cars per day,days to demand change\
		,starting customer demand cars per day)
	~	cars/Day
	~		|

days to demand change=25
	~	days
	~		|

ending customer demand cars per day=22
	~	cars/Day
	~		|

starting customer demand cars per day=20
	~	cars/Day
	~		|

deliveries=delay fixed (orders to factory,delivery delay,starting customer demand cars per day\
		)
	~	cars/Day
	~		|

delivery delay=5
	~	days
	~		|

desired days to sell out=10
	~	days
	~		|

desired inventory=desired days to sell out*percieved sales
	~	cars
	~		|

discrepancy between desired and actual inventory=desired inventory-inventory
	~	cars
	~		|

inventory= INTEG (deliveries-sales,
		starting cars in inventory)
	~	cars
	~		|

orders to factory=max(discrepancy between desired and actual inventory/response delay\
		+percieved sales, 0)
	~	cars/Day
	~		|

perception delay=5
	~	days
	~		|

percieved sales=smooth(sales,perception delay)
	~	cars/Day
	~		|

response delay=3
	~	days
	~		|

starting cars in inventory=200
	~	cars
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 100
	~	Day
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Day
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP
	~	Day [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 1
	~	Day [0,?]
	~	The time step for the simulation.
	|

