{UTF-8}
annual fertility rate=12/1000
	~	1/Year
	~		|

annual mortality rate=12/1000
	~	1/Year
	~		|

births=population*annual fertility rate
	~	people/Year
	~		|

deaths=annual mortality rate*population
	~	people/Year
	~		|

population= INTEG (births-deaths,
		starting population)
	~	people
	~		|

starting population=1000
	~	people
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 100
	~	Year
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Year
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP
	~	Year [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 1
	~	Year [0,?]
	~	The time step for the simulation.
	|

