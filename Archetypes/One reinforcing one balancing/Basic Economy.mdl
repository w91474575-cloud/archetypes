{UTF-8}
annual output=capital*output per unit capital
	~	capital
	~		|

capital= INTEG (investment-depreciation,
		starting capital)
	~	capital
	~		|

capital lifetime=20
	~	years
	~		|

depreciation=capital/capital lifetime
	~	capital/Year
	~		|

investment=annual output*investment fraction per year
	~	capital/Year
	~		|

investment fraction per year=0.1
	~	1/Year
	~		|

output per unit capital=0.5
	~	1
	~		|

starting capital=1000
	~	capital
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 100
	~	Year
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Year
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP
	~	Year [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 1
	~	Year [0,?]
	~	The time step for the simulation.
	|

